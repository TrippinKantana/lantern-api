{
  "buildCommand": "npm run build && node -e \"require('fs').mkdirSync('public',{recursive:true}); require('fs').writeFileSync('public/index.html','ok')\"",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
